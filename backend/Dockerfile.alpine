FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production

FROM node:20-alpine
WORKDIR /app
COPY --from=builder /app/node_modules ./node_modules
COPY . .
# SQLite benötigt manchmal zusätzliche Pakete
RUN apk add --no-cache sqlite
ENV NODE_ENV=production
EXPOSE 8050
CMD ["node", "server.js"]
