# Used by docker-compose.yml for variable substitution.
# Copy this file to .env in the repo root and fill in real values (never commit .env).
DOMAIN=dobs.example.org
# Required: at least 32 random characters, e.g. `openssl rand -hex 32`.
# The backend refuses to start without a proper secret.
JWT_SECRET=please-change-me-with-a-long-random-string
# Optional but recommended on public servers: only a sign-up with exactly this
# username becomes the first admin (otherwise the very first user does).
ADMIN_USERNAME=
NODE_ENV=production
# With docker-compose.yml: internal backend port (Traefik routes to it).
# With docker-compose.standalone.yml: the host port the app is reachable on.
PORT=8050
# Host bind mount: BASE_DIR/BINDS/data -> /app/data
BASE_DIR=/home/docker
BINDS=dobs

# Brand color of the UI as #rrggbb; all lighter/darker shades are derived
# from it. Read by the backend at runtime - a restart is enough, no rebuild.
# Leave empty for the built-in default (lime green #65a30d).
ACCENT_COLOR=#65a30d

# Optional proxy for building the images (npm install needs
# registry.npmjs.org). Leave empty when the host has direct internet access.
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=

# Optional sqlite-web admin UI (read/write DB browser, NO authentication -
# make sure this port isn't reachable from outside your LAN/VPN).
# Leave COMPOSE_PROFILES empty to skip starting it entirely.
COMPOSE_PROFILES=
SQLITE_WEB_PORT=8292
